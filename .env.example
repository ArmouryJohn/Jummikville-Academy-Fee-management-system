# =============================================================================
# Jummikville Fee Management System — Environment Variables
# =============================================================================
# Copy this file to .env for LOCAL development:
#   copy .env.example .env
#
# On Railway, you do NOT create a .env file — you add each variable below in the
# service's "Variables" tab instead. Notes on which are which are inline.
#
# NEVER commit your real .env file — it contains secrets!
# =============================================================================

# ---- Database ----
# LOCAL (SQLite — no setup needed):
DATABASE_URL=sqlite:///./jummikville.db
#
# RAILWAY (PostgreSQL): do NOT set this by hand. When you add a Postgres plugin
# to your project, Railway injects DATABASE_URL automatically. Reference it from
# your web service with:  DATABASE_URL=${{Postgres.DATABASE_URL}}

# ---- Paystack ----
# Get these from https://dashboard.paystack.com/#/settings/developers
# Use TEST keys during development (they start with sk_test_ and pk_test_)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Twilio ----
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio WhatsApp Sandbox number (change this when you get a verified number)
TWILIO_WHATSAPP_NUMBER=+14155238886

# ---- Auth / sessions ----
# REQUIRED in production. Sign-key for login tokens — anyone who knows it can
# forge a login. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Idle timeout for a login session, in minutes (optional; defaults to 30).
SESSION_TIMEOUT_MINUTES=30

# ---- Seed admin account ----
# Created automatically on first startup if it doesn't exist yet.
# Set ADMIN_PASSWORD so you know the password up front; otherwise a random one is
# generated and printed to the startup log ONCE.
ADMIN_EMAIL=admin@jummikville.sch
ADMIN_PASSWORD=change-me-before-deploying

# ---- App Settings ----
# Set to "production" when deploying (enables secure cookies, disables SQL echo,
# tightens CORS). Keep "development" locally.
APP_ENV=development
