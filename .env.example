# =============================================================================
# Jummikville Fee Management System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values:
#   copy .env.example .env
#
# NEVER commit your .env file — it contains secrets!
# =============================================================================

# ---- Database ----
# For development (SQLite — no setup needed):
DATABASE_URL=sqlite:///./jummikville.db

# For production (PostgreSQL — uncomment and fill in):
# DATABASE_URL=postgresql://user:password@host:5432/jummikville

# ---- Paystack ----
# Get these from https://dashboard.paystack.com/#/settings/developers
# Use TEST keys during development (they start with sk_test_ and pk_test_)
PAYSTACK_SECRET_KEY=sk_test_5373324d22f735888f0f5a6136c4c4f8e366e5ce
PAYSTACK_PUBLIC_KEY=pk_test_3c01e0e7ea4a44c9f2d1f4cd5e10e16425828a84

# ---- Twilio ----
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio WhatsApp Sandbox number (change this when you get a verified number)
TWILIO_WHATSAPP_NUMBER=+14155238886

# ---- App Settings ----
# Set to "production" when deploying
APP_ENV=development

# ---- Admin Account (Director) ----
# Auto-created on first startup. If ADMIN_PASSWORD is unset, a random password
# is generated and printed to the startup log ONCE.
ADMIN_EMAIL=admin@jummikville.sch
ADMIN_PASSWORD=ChangeMe!Admin123

# ---- Bursar Account (Staff Admin) ----
# OPTIONAL: set both to auto-create a second account on startup.
# Leave BURSAR_EMAIL blank (or remove both lines) to skip.
BURSAR_EMAIL=bursar@jummikville.sch
BURSAR_PASSWORD=ChangeMe!Bursar123

# ---- JWT Secret ----
# Must be a long random string in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
